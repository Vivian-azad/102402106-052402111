/* ================= 首页 ================= */
.home {
  min-height: 100vh;
  background: #FBF9F4;
}

/* ---------- 顶部栏 ---------- */
.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 130rpx 40rpx 0;
}
.brand { display: flex; align-items: center; gap: 20rpx; }

/* 心形 Logo（左绿右紫叠合） */
.logo {
  position: relative;
  width: 66rpx;
  height: 62rpx;
  flex-shrink: 0;
}
.logo-half {
  position: absolute;
  top: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50% 50% 6rpx 6rpx;
}
.logo-l {
  left: 6rpx;
  background: linear-gradient(150deg, #7FE5C3 0%, #4DD9A8 100%);
  transform: rotate(-45deg);
  border-radius: 50% 50% 8rpx 50%;
}
.logo-r {
  left: 20rpx;
  background: linear-gradient(150deg, #B79BF5 0%, #8B6FE8 100%);
  transform: rotate(45deg);
  border-radius: 50% 50% 50% 8rpx;
  opacity: .92;
}

.brand-txt { display: flex; flex-direction: column; }
.brand-title {
  font-size: 46rpx;
  font-weight: 800;
  color: #26243C;
  letter-spacing: 1rpx;
  line-height: 1.25;
}
.brand-sub {
  font-size: 26rpx;
  color: #A6A3B8;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

/* 右侧：发布 / 我的 */
.topacts { display: flex; align-items: flex-start; gap: 36rpx; padding-top: 8rpx; }
.act { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.act-ico {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.act-img { width: 42rpx; height: 42rpx; }
.act-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #EDE7FB;
  padding: 4rpx;
}
.bell-dot {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF7A9A;
  z-index: 2;
  box-shadow: 0 0 0 4rpx #FBF9F4;
}
.act-txt { font-size: 24rpx; color: #4A4763; font-weight: 500; }

/* ---------- 3D 校园图 ---------- */
.hero {
  position: relative;
  margin-top: 4rpx;
}
.hero-img { width: 100%; display: block; }

/* 浮动地点气泡 */
.spot {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx 8rpx 8rpx;
  background: rgba(255,255,255,.95);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(70, 60, 120, .12);
  transform: translate(-50%, -50%);
  white-space: nowrap;
  animation: floaty 3.4s ease-in-out infinite;
}
.spot:nth-child(2) { animation-delay: .3s; }
.spot:nth-child(3) { animation-delay: .7s; }
.spot:nth-child(4) { animation-delay: 1.1s; }
.spot:nth-child(5) { animation-delay: 1.5s; }

.spot-ico {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.spot-img { width: 22rpx; height: 22rpx; }
.spot-ico-mint   { background: linear-gradient(140deg, #6FE3BE, #3ECFA0); }
.spot-ico-purple { background: linear-gradient(140deg, #AE90F3, #8B6FE8); }
.spot-txt {
  font-size: 24rpx;
  font-weight: 600;
  color: #3A3752;
  letter-spacing: .5rpx;
}

/* ---------- 区块标题 ---------- */
/* ---------- 搜索栏 ---------- */
.searchbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 40rpx 0;
  height: 88rpx;
  padding: 0 12rpx 0 30rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(139, 111, 232, 0.10);
}
.searchbar:active { transform: scale(.985); }
.sb-ico { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.sb-ph  { flex: 1; font-size: 27rpx; color: #B7B4C7; }
.sb-btn {
  height: 64rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(140deg, #6FE3BE, #3ECFA0);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(62, 207, 160, 0.30);
}

.sec-head { margin-top: 26rpx; padding: 0 40rpx; margin-bottom: 22rpx; }
.sec-title { font-size: 40rpx; font-weight: 800; color: #26243C; letter-spacing: 1rpx; }
.sec-more  { display: flex; align-items: center; gap: 6rpx; font-size: 26rpx; color: #9C99B0; }
.more-arrow { width: 24rpx; height: 24rpx; }

/* ---------- 分类 Tab ---------- */
.tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 40rpx 24rpx;
  white-space: nowrap;
}
.tab {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #8E8BA3;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 60rpx;
  box-shadow: 0 4rpx 14rpx rgba(139,111,232,.06);
  transition: all .25s;
}
.tab-on {
  background: linear-gradient(135deg, #6FE3BE 0%, #3ECFA0 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(62, 207, 160, .32);
}

/* ---------- 卡片流 ---------- */
.feed {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 0 40rpx;
}
.feed > info-card {
  width: calc((100% - 24rpx) / 2);
}

.loading {
  text-align: center;
  color: #B7B4C7;
  font-size: 26rpx;
  padding: 60rpx 0;
}
