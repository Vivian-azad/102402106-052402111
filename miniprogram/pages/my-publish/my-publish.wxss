/* ================= 我的发布 ================= */
.mp {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #F7F5FD 0%, #F5F4FC 40%, #FBF9F4 100%);
  overflow: hidden;
  padding-bottom: 60rpx;
}
.mp-blob-1 { width: 260rpx; height: 260rpx; top: -70rpx; right: -90rpx; }
.mp-blob-2 { width: 220rpx; height: 220rpx; bottom: 200rpx; left: -90rpx; }

/* 顶部 */
.dt-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 110rpx 40rpx 20rpx;
  z-index: 2;
}
.back-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(139,111,232,.12);
}
.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #3A3752;
  border-bottom: 4rpx solid #3A3752;
  transform: rotate(45deg);
  margin-left: 6rpx;
  border-radius: 2rpx;
}
.dt-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #26243C;
  letter-spacing: 2rpx;
}
.dt-top-holder { width: 84rpx; }

/* 统计条 */
.mp-stat {
  position: relative;
  display: flex;
  align-items: center;
  margin: 10rpx 40rpx 0;
  padding: 32rpx 20rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 26rpx rgba(139,111,232,.08);
  z-index: 2;
}
.mp-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.mp-stat-num {
  font-size: 46rpx;
  font-weight: 800;
  color: #26243C;
  line-height: 1;
}
.mp-stat-mint   { color: #3ECFA0; }
.mp-stat-purple { color: #8B6FE8; }
.mp-stat-txt { font-size: 24rpx; color: #9C99B0; }
.mp-stat-line {
  width: 2rpx;
  height: 56rpx;
  background: #F2F1F8;
}

.mp-tip {
  padding: 24rpx 40rpx 20rpx;
  font-size: 24rpx;
  color: #A6A3B8;
  position: relative;
  z-index: 2;
}

/* 列表 */
.feed {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 0 40rpx;
  position: relative;
  z-index: 2;
}
.feed > info-card { width: calc((100% - 24rpx) / 2); }

.mp-empty {
  padding-top: 120rpx;
  position: relative;
  z-index: 2;
}
.mp-space { height: 60rpx; }
