/* ================= 编辑个人资料 ================= */
.ep {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #F7F5FD 0%, #F5F4FC 40%, #FBF9F4 100%);
  overflow: hidden;
  padding-bottom: 60rpx;
}
.ep-blob-1 { width: 260rpx; height: 260rpx; top: -70rpx; right: -90rpx; }
.ep-blob-2 { width: 220rpx; height: 220rpx; top: 420rpx; left: -90rpx; }

/* 顶部（复用全局 dt-top 样式，这里兜底一份） */
.dt-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 110rpx 40rpx 20rpx;
  z-index: 2;
}
.back-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(139,111,232,.12);
}
.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #3A3752;
  border-bottom: 4rpx solid #3A3752;
  transform: rotate(45deg);
  margin-left: 6rpx;
  border-radius: 2rpx;
}
.dt-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #26243C;
  letter-spacing: 2rpx;
}
.dt-top-holder { width: 84rpx; }

/* ---------- 头像 ---------- */
.ep-avatar-wrap {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 10rpx;
}
.ep-avatar {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #EDE7FB;
  padding: 8rpx;
  box-shadow: 0 12rpx 34rpx rgba(139,111,232,.20);
}
.ep-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #F3EEFE;
}
/* 右下角相机角标 */
.ep-avatar-cam {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #9B7DEE 0%, #8B6FE8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(139,111,232,.34);
}
.ep-cam-ico { width: 30rpx; height: 30rpx; }

.ep-avatar-tip {
  margin-top: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #8B6FE8;
}
.ep-avatar-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A6A3B8;
}

/* ---------- 表单 ---------- */
.ep-form {
  position: relative;
  z-index: 2;
  margin: 34rpx 40rpx 0;
}
.f-ico { width: 34rpx; height: 34rpx; }

.ep-note {
  position: relative;
  z-index: 2;
  padding: 24rpx 52rpx 0;
  font-size: 24rpx;
  color: #A6A3B8;
  line-height: 1.6;
}

/* ---------- 保存 ---------- */
.ep-submit-wrap {
  position: relative;
  z-index: 2;
  padding: 48rpx 40rpx 60rpx;
}
.ep-submit {
  height: 104rpx;
  font-size: 36rpx;
  letter-spacing: 12rpx;
  border-radius: 999rpx;
  text-indent: 12rpx;   /* 抵消 letter-spacing 造成的右偏 */
}
.ep-submit.is-saving { opacity: .7; }
