/* ============ 自定义底部导航 · 3 tab ============ */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  box-shadow: 0 -6rpx 30rpx rgba(139, 111, 232, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}
.tabbar-inner {
  display: flex;
  align-items: stretch;
  height: 112rpx;
}

/* tab 项（等宽三份） */
.tb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.tb-item:active { opacity: .7; }
.tb-ico { width: 46rpx; height: 46rpx; }
.tb-txt {
  font-size: 22rpx;
  color: #B7B4C7;
  font-weight: 500;
  letter-spacing: .5rpx;
}
.tb-on { color: #3ECFA0; font-weight: 700; }
